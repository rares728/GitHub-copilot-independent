NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:change-this@localhost:5432/rcca_tracker
POSTGRES_PASSWORD=generate-a-random-hex-password-for-docker
DATABASE_SSL=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-random-password-of-at-least-12-characters
ADMIN_NAME=RCCA Administrator
FILE_SIGNING_SECRET=change-this-to-a-random-secret-at-least-32-characters
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400
COOKIE_SECURE=false
TRUST_PROXY=false
APP_BASE_URL=http://localhost:3000
TZ=UTC
REMINDER_CRON=0 8 * * *
DOWNTIME_ALERT_EMAIL=
CRITICAL_ALERT_EMAIL=

# Optional SMTP settings (set SMTP_URL or SMTP_HOST)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_URL=

# Optional OpenAI-compatible provider settings
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Example: {"gemini_3_flash":{"baseUrl":"http://localhost:11434/v1","model":"qwen2.5vl:7b"},"claude_sonnet_4_6":{"baseUrl":"https://api.example/v1","model":"model-name","apiKeyEnv":"AI_SECONDARY_API_KEY"}}
AI_MODELS_JSON={}
